# Supabase (optional). Leave blank to run on the built-in browser demo backend.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: set to 'development' or 'production'
VITE_APP_ENV=development

# Optional: serve from a sub-path (e.g. /PoolPass-Cleaned-2.0/ on GitHub Pages)
# VITE_BASE_PATH=/

# Optional: 'browser' (default), 'hash' or 'memory'
# VITE_ROUTER_MODE=browser
